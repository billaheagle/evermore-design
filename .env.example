# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---- Database ----------------------------------------------------------------
# PostgreSQL connection string. Example:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=

# ---- Admin login ------------------------------------------------------------
# The only credentials that can sign in to /admin. No user table, no signup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-long

# Secret used to sign the admin session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Contact-form email notification (optional) -----------------------------
# If both are set, each new enquiry is also emailed via Resend (https://resend.com).
# Leave blank to just collect messages in /admin/inbox.
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=
# Optional "From" — must be a verified Resend sender/domain.
INQUIRY_NOTIFY_FROM=
